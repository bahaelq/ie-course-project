# Choose one provider: academiccloud or openai.
AI_PROVIDER=academiccloud

# AcademicCloud Chat AI: https://chat-ai.academiccloud.de/v1
# Request an API key from AcademicCloud Chat AI.
CHAT_AI_API_KEY=your-chat-ai-api-key
CHAT_AI_MODEL=qwen3.5-122b-a10b

# To use OpenAI instead, set AI_PROVIDER=openai and configure these values.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
